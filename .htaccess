# Family Friend Chat / LivingRoom PWA - SPA fallback routing
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request is for an actual file or directory that exists, serve it directly
  # (this covers your JS/CSS/images/manifest/service worker, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, fall back to index.html and let React Router handle the path
  RewriteRule ^ index.html [L]
</IfModule>